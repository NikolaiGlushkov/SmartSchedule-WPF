<Window x:Class="SmartSchedule.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSchedule"
        mc:Ignorable="d"
        Title="SmartSchedule" Height="450" Width="800" Loaded="Window_Loaded" Closing="Window_Closing">

    <!--1.1: move DataGrid to UserControl-->
    <!--1.1: make Custom COntrol for DatePicker validation and move it to DLL-->
    <!--1.1: try to use ResourceDictionary for a common style-->
    <Grid Focusable="True" MouseLeftButtonDown="HeaderSendFocusToGrid_MouseLeftButtonDown" >

        <TabControl x:Name="tabContr" ItemsSource="{Binding TCDataList}" Margin="5">

            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabControl">
                                <Grid KeyboardNavigation.TabNavigation="Local" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <WrapPanel Grid.Row="0" Background="Transparent" >
                                        <TabPanel IsItemsHost="True" Margin="0,0,0,0" ZIndex="1"/>
                                        <Button Content="+" Padding="0,-7,0,-2" FontSize="20" FontWeight="Bold" Width="20" Height="20" Cursor="Hand" Click="AddTabButton_Click" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <Border Grid.Row="1">
                                        <ContentPresenter ContentSource="SelectedContent"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="ItemsPanel">
                        <Setter.Value>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Style>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" MouseLeftButtonDown="HeaderChange_MouseLeftButtonDown">
                        <TextBlock Text="{Binding Header}" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,5,0" 
                                   MinWidth="50" 
                                   Visibility="Visible"/>
                        <TextBox Text="{Binding Header, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" 
                                 Visibility="Collapsed" 
                                 VerticalAlignment="Center" 
                                 Margin="0,0,5,0" 
                                 MinWidth="50" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 KeyDown="HeaderApprovingOrCancelling_KeyDown" 
                                 LostFocus="HeaderApproving_LostFocus" />
                        <Button Tag="{Binding}" Content="x" Padding="0,-3,0,0" FontWeight="Bold" Cursor="Hand" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" Click="CloseTabButton_Click" />
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate>
                    

                    <DataGrid x:Name="dgSmSchedule" 
                              ItemsSource="{Binding DGDataList}" 
                              FontSize="15" AutoGenerateColumns="False" 
                              CanUserAddRows="True" 
                              CanUserDeleteRows="True"  
                              SelectionMode="Extended"
                              VirtualizingPanel.IsVirtualizing="False"
                              LoadingRow="dgSmSchedule_LoadingRow" 
                              UnloadingRow="RowHeaderUpdate_UnloadingRow" 
                              PreviewKeyDown="DataGrid_PreviewKeyDown"
                              PreviewTextInput="DataGrid_PreviewTextInput"
                              CanUserResizeRows="False">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" x:Key="WrapText">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.RowHeaderStyle>
                            <Style TargetType="DataGridRowHeader">
                                <Setter Property="VerticalContentAlignment" Value="Top" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="-3, 0, 0, 0" />
                                <Setter Property="Width" Value="25"/>

                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" 
                                                       Margin="0,-2,2,0"
                                                       HorizontalAlignment="Left"/>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.RowHeaderStyle>

                        <DataGrid.RowValidationErrorTemplate>
                            <ControlTemplate />
                        </DataGrid.RowValidationErrorTemplate>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">


                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImportant}" Value="true">
                                        <Setter Property="Background" Value="LightPink"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDone}" Value="true">
                                        <Setter Property="Background" Value="PaleGreen"/>
                                    </DataTrigger>

                                    <Trigger Property="IsNewItem" Value="True">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridRow">
                                                    <Button Content="Add new task" 
                                                            HorizontalAlignment="Stretch" 
                                                            Cursor="Hand"
                                                            Height="25" 
                                                            VerticalAlignment="Bottom" 
                                                            FontSize="15" 
                                                            FontWeight="Bold"
                                                            Command="{Binding DataContext.AddRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        
                        
                        
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding CreationDate, StringFormat={}{0:d}}" IsReadOnly="True" Header="Created" Width="100" />

                            
                            <DataGridTemplateColumn Header="Deadline" Width="100" SortMemberPath="DeadLine" CanUserSort="True" >

                                <DataGridTemplateColumn.CellTemplate >
                                    <DataTemplate>
                                        <Grid x:Name="TextBlockError" >

                                            <TextBlock Text="{Binding DeadLine, StringFormat={}{0:d}}"
                                                       x:Name="TextBlockDL"
                                                       Validation.ErrorTemplate="{x:Null}"
                                                       Padding="5,0"
                                                       Margin="-3,0,0,0"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}" Value="True">
                                                                <Setter Property="Foreground" Value="Red" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                
                                            </TextBlock>

                                            <TextBlock Text="{Binding DeadLineError}" 
                                                       x:Name="TextBlockDLE"
                                                       Padding="5,0"
                                                       Margin="-3,0,0,0"
                                                       Validation.ErrorTemplate="{x:Null}"
                                                       VerticalAlignment="Top"
                                                       HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DeadLine}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeadLineError}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DeadLineError}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.HasError)}" Value="True">
                                                                <Setter Property="Foreground" Value="Red" />
                                                            </DataTrigger>
                                                        </Style.Triggers>

                                                    </Style>

                                                </TextBlock.Style>
                                 
                                            </TextBlock>

                                            <Popup x:Name="MyErrorPopup"
                                                   PlacementTarget="{Binding ElementName=TextBlockError}" 
                                                   Placement="Bottom"
                                                   AllowsTransparency="True"
                                                   StaysOpen="True">
                                            
                                                <Popup.Style>
                                                    <Style TargetType="Popup">
                                                  
                                                        <Setter Property="IsOpen" Value="False" />

                                                        <Style.Triggers>

                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding ElementName=TextBlockDLE, Path=(Validation.HasError)}" Value="True" />
                                                                    <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsKeyboardFocusWithin}" Value="True" />
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="IsOpen" Value="True" />
                                                            </MultiDataTrigger>


                                                            <Trigger Property="IsOpen" Value="True">
                                                                <Trigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Child.Opacity"
                                                                                             From="1.0" To="1.0" Duration="0:0:1" />
                                                                            <DoubleAnimation Storyboard.TargetProperty="Child.Opacity"
                                                                                             From="1.0" To="0.0" BeginTime="0:0:1" Duration="0:0:1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </Trigger.EnterActions>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Popup.Style>

                                                <Border Background="#FFFEEBEB" BorderBrush="Red" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                                    <TextBlock Text="{Binding ElementName=TextBlockDLE, Path=(Validation.Errors)[0].ErrorContent}" 
                                                               Foreground="DarkRed" FontSize="11" />
                                                </Border>
                                            </Popup>

                                        </Grid>
                                    </DataTemplate>

                                </DataGridTemplateColumn.CellTemplate>

                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding DeadLine, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" 
                                                        Validation.ErrorTemplate="{x:Null}"
                                                        Loaded="DatePicker_Loaded"
                                                        CommandManager.PreviewCanExecute="DatePicker_PreviewCanExecute"
                                                        SelectedDateChanged="DatePicker_SelectedDateChanged"
                                                        BorderThickness="0"
                                                        DateValidationError="DatePicker_DateValidationError"
                                                        Padding="-3,0,0,0"
                                                        VerticalAlignment="Top" 
                                                        HorizontalAlignment="Left" 
                                                        CalendarClosed="DatePicker_CalendarClosed">

                                                <DatePicker.Resources>

                                                    <Style TargetType="Button" >
                                                        <Setter Property="MaxWidth" Value="14"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.9" ScaleY="0.8" CenterX="10" CenterY="10"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>

                                                    <Style TargetType="Popup">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    </Style>

                                                    <Style TargetType="DatePickerTextBox">
                                                        <EventSetter Event="PreviewKeyDown" Handler="DatePickerTextBox_PreviewKeyDown"/>
                                                        <EventSetter Event="PreviewTextInput" Handler="DatePickerTextBox_PreviewTextInput"/>
                                                        <Setter Property="MaxLength" Value="10"/>
                                                        <Setter Property="FontSize" Value="15"/>

                                                    </Style>

                                                </DatePicker.Resources>

                                                <DatePicker.CalendarStyle>
                                                    <Style TargetType="Calendar">
                                                        <Style.Resources>
                                                            <Style TargetType="Button" BasedOn="{x:Null}" />
                                                        </Style.Resources>
                                                    </Style>
                                                </DatePicker.CalendarStyle>

                                            </DatePicker>

                                    </DataTemplate>

                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>


                            <DataGridCheckBoxColumn Binding="{Binding IsDone, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" CanUserSort="True" IsReadOnly="False" Header="Done" Width="50">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox">
                                        <EventSetter Event="Click" Handler="CheckBox_Click"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>

                            <DataGridCheckBoxColumn Binding="{Binding IsImportant, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" CanUserSort="True" IsReadOnly="False" Header="!" Width="50" >
                                <DataGridCheckBoxColumn.HeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridCheckBoxColumn.HeaderStyle>
                            </DataGridCheckBoxColumn>

                            <DataGridTextColumn Binding="{Binding Expenses, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" IsReadOnly="False" Header="Expenses" Width="100" ElementStyle="{StaticResource WrapText}">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Binding="{Binding Text, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}"  IsReadOnly="False"  Header="Text" Width="*" CanUserSort="False" ElementStyle="{StaticResource WrapText}">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="AcceptsReturn" Value="True"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>

    </Grid>
</Window>
